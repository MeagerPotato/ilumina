# Copy to .env and fill in. Never commit .env.

# Deepgram: speech to text (Flux) and text to speech (Aura-2)
DEEPGRAM_API_KEY=
DEEPGRAM_VOICE_ID=aura-2-helena-en

# Google AI Studio key
GOOGLE_API_KEY=
# Tutor brain. Fallback if Argon is unavailable or slow: gemini-3.8-flash
GOOGLE_MODEL=gemini-4-argon
# Emotion scoring (Decisions API)
DECISION_MODEL=gemini-decision-1
