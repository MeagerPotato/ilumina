# Copy to .env and fill in. Never commit .env.

# Deepgram: speech to text (Flux) and text to speech (Aura-2)
DEEPGRAM_API_KEY=
DEEPGRAM_VOICE_ID=aura-2-helena-en

# Google AI Studio key
GOOGLE_API_KEY=
# Tutor brain. Hydrogen answers about three times sooner than gemini-4-argon.
GOOGLE_MODEL=gemini-4-hydrogen
# Emotion scoring (Decisions API)
DECISION_MODEL=gemini-decision-1

# Memory: "on" saves the hard moments of each tutoring session to memory/ (local only).
# Lectures recorded with lecture.py are saved only when you say yes at the end.
ILUMINA_MEMORY=off
